.link .to-null { stroke-dasharray: 0.5, 3.5; stroke-linecap: round; }

.link .from-data { stroke: rgb(49, 130, 189); }

.play circle { fill: rgb(255, 255, 255); stroke: rgb(0, 0, 0); stroke-width=
: 3px; }

