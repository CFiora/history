html { min-width: 1040px; }

.ocks-org body { background: rgb(252, 252, 250); color: rgb(51, 51, 51); fo=
nt-family: "PT Serif", serif; margin: 1em auto 4em; position: relative; wid=
th: 960px; }

.ocks-org header, .ocks-org footer, .ocks-org aside, .ocks-org h1, .ocks-or=
g h2, .ocks-org h3, .ocks-org h4, .ocks-org h5 { font-family: "PT Sans", sa=
ns-serif; }

.ocks-org h1, .ocks-org h2, .ocks-org h3, .ocks-org h4, .ocks-org h5 { colo=
r: rgb(0, 0, 0); }

.ocks-org header, .ocks-org footer { color: rgb(99, 99, 99); }

h5 { font-size: 54px; font-weight: 300; letter-spacing: -2px; margin: 0.3em=
 0px 0.1em; text-rendering: optimizelegibility; }

h1 { font-size: 64px; font-weight: 300; letter-spacing: -2px; margin: 0.3em=
 0px 0.1em; }

h2 { margin-top: 2em; }

h1, h2 { text-rendering: optimizelegibility; }

h2 a[name], h2 a[id] { color: rgb(204, 204, 204); right: 100%; padding: 0px=
 0.3em; position: absolute; }

header, footer { font-size: small; }

.ocks-org header aside, .ocks-org footer aside { float: left; margin-right:=
 0.5em; }

.ocks-org header aside::after, .ocks-org footer aside::after { padding-left=
: 0.5em; content: "/"; }

footer { margin-top: 8em; }

h1 ~ aside { font-size: small; right: 0px; position: absolute; width: 180px=
; }

.attribution { font-size: small; margin-bottom: 2em; }

body > p, li > p { line-height: 1.5em; }

body > p { width: 720px; }

body > blockquote { width: 640px; }

blockquote q { display: block; font-style: oblique; }

ul { padding: 0px; }

li { width: 690px; margin-left: 30px; }

a { color: steelblue; }

a:not(:hover) { text-decoration: none; }

pre, code, textarea { font-family: Menlo, monospace; }

code { line-height: 1em; }

